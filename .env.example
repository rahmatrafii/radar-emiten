# ===== Mode & Server =====
APP_MODE=mock
HOST=0.0.0.0
PORT=8080
RUST_LOG=info

# ===== Database =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=idx_sentinel
POSTGRES_PORT=5434
DATABASE_URL=postgres://postgres:postgres@localhost:5434/idx_sentinel

# ===== LLM (DeepSeek / Gemini) =====
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ===== WhatsApp Cloud API =====
# Mode real: isi semua credentials di bawah + set APP_MODE=real.
# Mode mock: biarkan kosong (default) — pengiriman akan mock_sent.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# ===== Keamanan internal =====
ADMIN_PHONE=
INTERNAL_API_TOKEN=

# ===== Kredit & batas =====
SECTORS_CREDIT_BUDGET=1000
MAX_ALERTS_PER_DAY=3
NEUTRAL_RELATIVE_THRESHOLD=0.02
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=86400

# ===== MCP — stdio transport =====
# MCP_TRANSPORT: gunakan "stdio" untuk spawn subprocess mcp-server.
# MCP_SERVER_COMMAND: path ke binary mcp-server (relatif dari direktori tempat `cargo run` dijalankan).
#   - Dari dalam folder orchestrator/: gunakan ../target/debug/mcp-server
#   - Dari root repo: gunakan target/debug/mcp-server
# MCP_SERVER_ARGS: argumen tambahan untuk binary (biasanya kosong).
MCP_TRANSPORT=stdio
MCP_SERVER_COMMAND=../target/debug/mcp-server
MCP_SERVER_ARGS=
MCP_CALLBACK_BASE_URL=http://127.0.0.1:8080

# ===== Kebijakan disclaimer =====
# Konflik disclaimer sudah diselesaikan (7 Okt 2026).
# Set true untuk mengaktifkan pengiriman WhatsApp real.
POLICY_DISCLAIMER_CONFLICT_ACKNOWLEDGED=true

# ===== Sectors API (bagian Data & MCP Layer) =====
SECTORS_API_KEY=your_sectors_api_key_here

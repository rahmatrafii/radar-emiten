# ==============================================================================
# Financial Market Research Agent - Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/sectors_db

# Sectors API v2 Configuration
# Dapatkan API Key v2 dari portal resmi Sectors
SECTORS_API_KEY=your_sectors_api_key_v2
SECTORS_API_BASE_URL=https://api.sectors.app/v2

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# WhatsApp Cloud API Configuration
WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
WHATSAPP_RECIPIENT_PHONE_NUMBER=6281234567890

# MCP Server & Backend Ports
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
MCP_SERVER_PORT=3000
RUST_LOG=info

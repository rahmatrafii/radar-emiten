# Environment Variables — IDX Sentinel
# JANGAN commit file ini ke git!
# Salin file ini menjadi .env dan isi dengan nilai yang sebenarnya.

# API Key Sectors App
# Dapatkan dari: https://sectors.app/api
SECTORS_API_KEY=your_sectors_api_key_here

# Level logging (optional)
# Opsi: error, warn, info, debug, trace
RUST_LOG=radar_emiten=info,warn
